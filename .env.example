# Copie este arquivo para ".env" e preencha com as suas credenciais reais.
# Nunca faça commit do arquivo ".env" (ele já está no .gitignore).

# Azure Speech (transcrição de áudio das consultas)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure Text Analytics (sentimento e termos críticos na transcrição)
AZURE_TEXT_ANALYTICS_KEY=
AZURE_TEXT_ANALYTICS_ENDPOINT=

# OpenAI (parecer final com pontuação 0-10 e item de maior risco)
OPENAI_API_KEY=
# Opcional: modelo a usar no relatório final (default: gpt-4.1-mini)
OPENAI_MODEL=
# Opcional: modelo reserva para usar automaticamente em rate limit (default: gpt-4o-mini)
OPENAI_FALLBACK_MODEL=
